*.swp
.buildlog/
.history

# pubspec.lock SI se versiona: esto es una aplicacion, no una libreria.
# Fijar las versiones garantiza que todos los developers y el servidor de
# build usen exactamente los mismos paquetes. (Flutter lo recomienda para apps.)
# Si se dejara fuera, cada clon resolveria versiones distintas y podrian
# aparecer errores de compilacion que solo se ven en la maquina de uno.



# Flutter repo-specific
/bin/cache/
/bin/internal/bootstrap.bat
/bin/internal/bootstrap.sh
/bin/mingit/
/dev/benchmarks/mega_gallery/
/dev/bots/.recipe_deps
/dev/bots/android_tools/
/dev/devicelab/ABresults*.json
/dev/docs/doc/
/dev/docs/flutter.docs.zip
/dev/docs/lib/
/dev/docs/pubspec.yaml
/dev/integration_tests/**/xcuserdata
/dev/integration_tests/**/Pods
/packages/flutter/coverage/
version
analysis_benchmark.json

